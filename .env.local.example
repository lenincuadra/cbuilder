# Copy to .env.local (gitignored). Everything here is optional: with nothing set,
# the app runs 100% locally (file store, no auth gate). For deploy, see docs/deploy.md.

# Durable registry in Supabase, accessed ONLY from the server with the service
# role key (never shipped to the browser). Without these, the registry uses the
# local file store. Supabase → Project settings → API: "Project URL" + "service_role".
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Basic-auth gate for the whole app (the registry is private). Set BOTH to enable;
# unset = no gate (fine for local dev). Use a long random password on deploy.
BASIC_AUTH_USER=lenin
BASIC_AUTH_PASSWORD=YOUR-LONG-RANDOM-PASSWORD

# Google Docs sink (optional): each generated CV is also created in your Drive
# as a native Google Doc via your Apps Script webhook. See docs/gdocs-setup.md.
# Server-side only (never shipped to the browser). Absent = feature off.
GDOCS_SCRIPT_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
GDOCS_TOKEN=YOUR-LONG-RANDOM-TOKEN
