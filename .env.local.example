# Copy this file to .env.local (gitignored) and fill in your Supabase project values.
# Project settings -> API: "Project URL" and the "anon public" key.
# Without these, the app falls back to per-browser localStorage (not durable).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google Docs sink (optional): each generated CV is also created in your Drive
# as a native Google Doc via your Apps Script webhook. See docs/gdocs-setup.md.
# Server-side only (never shipped to the browser). Absent = feature off.
GDOCS_SCRIPT_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
GDOCS_TOKEN=YOUR-LONG-RANDOM-TOKEN
